# Copy to .env and fill in.

# REQUIRED: your server-side SDK key (starts with "sdk-").
# LaunchDarkly -> Account settings -> Projects -> <your project> -> <environment>.
LD_SDK_KEY=sdk-your-key-here

# OPTIONAL: a LaunchDarkly trigger URL that turns flag targeting off.
# Create on the flag: Settings -> Triggers -> Generic trigger ->
# "Turn flag targeting off". Enables the "emergency de-sparkle" button;
# you can also fire it by hand: curl -X POST <url>
# LD_TRIGGER_URL=https://app.launchdarkly.com/webhook/triggers/...

# OPTIONAL: web server port (default 5055).
# PORT=5055
